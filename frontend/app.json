{
  "expo": {
    "name": "EcoTrack",
    "slug": "ecotrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/image/logoEcoTrackPreto.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/image/logoEcoTrackPreto.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/image/logoEcoTrackPreto.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/image/logoEcoTrackPreto.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o EcoTrack acesse suas fotos para anexar uma imagem ao relato.",
          "cameraPermission": "Permita que o EcoTrack use a câmera para tirar uma foto do relato.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o EcoTrack use sua localização ao registrar um relato."
        }
      ]
    ]
  }
}
